{
  "name": "gafs-awatch",
  "private": true,
  "description": "GAFS A-Watch — attendance monitoring system",
  "scripts": {
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:walkthrough": "playwright test --config=e2e/playwright.config.ts e2e/tests/walkthrough.spec.ts",
    "test:e2e:walkthrough:narrated": "PATH=\"/opt/homebrew/bin:/usr/local/bin:$PATH\" NARRATE_WALKTHROUGH=1 playwright test --config=e2e/playwright.config.ts e2e/tests/walkthrough.spec.ts",
    "remerge:narration": "PATH=\"/opt/homebrew/bin:/usr/local/bin:$PATH\" node scripts/remerge-narration.mjs all",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  }
}
